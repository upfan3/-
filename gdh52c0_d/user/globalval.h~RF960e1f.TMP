typedef struct
{
  
	uint64_t bit_OVER_V:1;       //过压0
	uint64_t bit_OWR_V: 1;       //电池欠压1
	uint64_t bit_OWR_V2:1;       //输出欠压2
	uint64_t bit_BATTDOWN_ALARM:1; //电池下电告警3
	
	uint64_t bit_BATTSUPPLY_ALARM:1;//电池放电告警4
	uint64_t bit_IN_OVER_VA:1;  //A输入过压5
	uint64_t bit_IN_OVER_VB:1;  //B输入过压6
  uint64_t bit_IN_OVER_VC:1;  //B输入过压7
	
	uint64_t bit_IN_OWR_VA:1;   //输入欠压8
	uint64_t bit_IN_OWR_VB:1;   //输入欠压9
	uint64_t bit_IN_OWR_VC:1;   //输入欠压10
	
	uint64_t bit_IN_OVER_IA:1;  //输入过流11
	
	uint64_t bit_IN_OVER_IB:1;  //输入过流12
	uint64_t bit_IN_OVER_IC:1;  //输入过流13
	uint64_t bit_OVER_FRQ:1;   //输入频率过高14	
	uint64_t bit_OWR_FRQ:1;    //输入频率过低15
	
	uint64_t bit_OWR_PHA:1;     //A缺相16
	uint64_t bit_OWR_PHB:1;     //B缺相17
	uint64_t bit_OWR_PHC:1;     //C缺相18
	uint64_t bit_SPDSW_DOWN:1;//防雷开关19
	
	uint64_t bit_spd:1;//防雷20
	uint64_t bit_ACINPUT:1;//交流输入21
	uint64_t bit_OILINPUT:1;	//油机输入22
	uint64_t bit_AC:1;//空调23
	
	
	uint64_t bit_BATT_LTEMP:1;	  //电池温度低24
	uint64_t bit_BATT_HTEMP:1;   //电池温度高25
	uint64_t bit_WATERIN_DOWN:1;//水浸26
	uint64_t bit_SMOKE_BREAK:1;	//烟雾27
	
	uint64_t bit_DOOR_BREAK:1;//门禁28
	uint64_t bit_BATTFUSR_BREAK:1;//电池熔丝29
	uint64_t bit_USER1_BREAK:1;//用户熔丝1 30
	uint64_t bit_USER2_BREAK:1;//用户熔丝2 31
	
	uint64_t bit_ENV_LTEMP:1;   //环境温度低 32
  uint64_t bit_ENV_HTEMP:1;   //环境温度高 33
	
	//uint64_t bit_PH1_FLASH_BREAK:1;//外设flash 故障 34
	
}Alarmbit;	


