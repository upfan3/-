#define cNew(p,t) p=(t *)pvPortMalloc(sizeof(t));\
                   p->Init();


#define vNew(p,t,x) p=(t *)pvPortMalloc(sizeof(t));\
                   p->Init(x);
									 
#define dNew(p,t,x,y) p=(t *)pvPortMalloc(sizeof(t));\
                  p->Init(x,y);


