#define PARA_FLAG 0x4A9A//0x3A9A


#define MAX_HOT_FAN_RECV_LEN 30



#define ENERGY_DATA_90_RECORD_LEN 90

#define SOI        0x7E
#define EOI        0x0D 

//按2字节取数据
