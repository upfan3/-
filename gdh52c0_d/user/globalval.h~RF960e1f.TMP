//I2C1
#define AD_PARA0 0x80 
#define AD_PARA  0x0100
#define SYS_PARA_FLAG  0x014A //参数已写入标志
#define SYS_PARA_LEN8  0x014C //单字节数据长
#define SYS_PARA_LEN16 0x014E //双字节数据长
#define SYS_PARA       0x0150 //参数首地址
#define USER_DOWN_PARA 0x0600
#define USER_DOWN_STAMP (USER_DOWN_PARA+280)  //单用户为 8+8+6+6=28 总共10个 280/512

#define ALARM_DATA_FlAG  0x0800//告警标志    单个告警 6字节时间+2字节信息 8字 
#define ALARM_DATA_LEN   (ALARM_DATA_FlAG+2) //0x0802//告警长度
#define ALARM_DATA_STAR  (ALARM_DATA_LEN+2)  //0x0804//第一条告警
#define ALARM_DATA_HEAD   (0x0804+12*2000)        //各告警的头指针
#define ALARM_DATA_TAIL   (ALARM_DATA_HEAD+12)    //各告警的尾指针
#define ENERGY_DATA_FLAG  (ALARM_DATA_TAIL+12)    //电量存取标志
#define ENERGY_DATA_LEN   (ENERGY_DATA_FLAG+2)
#define ENERGY_DATA_STAR  (ENERGY_DATA_LEN+2)    //电量存放起始位置 //48条电量抄表记录

#define TIME_LEN                 6     //时间长度
#define USER_ENERGY_DATA_LEN     32   //4*8  8个用户电量
#define AC_ENERGYDATA_LEN        48   //4*12 6个电量记录，6个费用记录
#define TOTAL_DATA_LEN           (TIME_LEN+USER_ENERGY_DATA_LEN+AC_ENERGYDATA_LEN)  //86
#define ENERGY_48_DATA_LEN      (((u32)TOTAL_DATA_LEN)*48+4) 

#define BATT_TEST_DATA_FLAG  (ENERGY_DATA_STAR+ENERGY_48_DATA_LEN)
#define BATT_TEST_DATA_LEN   (BATT_TEST_DATA_FLAG+2)
#define BATT_TEST_DATA_STAR  (BATT_TEST_DATA_LEN+2)

//I2C2
#define ENERGY_90DAY_DATA_FLAG  0x0000 
#define ENERGY_90DAY_DATA_LEN   (ENERGY_90DAY_DATA_FLAG+2)
#define ENERGY_90DAY_DATA_START (ENERGY_90DAY_DATA_LEN+2) //I2C2


#define ENERGY_90DAY_TOTAL_LEN  (((u32)TOTAL_DATA_LEN)*90+4)  //一条记录包括 记录时间 8个用户电量记示，6个交流电量记录（1个总电能，4个错峰时段电能，1个错峰时段总电能，1个总电费，4个错峰时段电费，1个错峰时段总电费）,50个其它

//租户参数保存
#define USER0_DOWN_DATA ENERGY_90DAY_DATA_FLAG + ENERGY_90DAY_TOTAL_LEN
#define USER_DATA_LEN 2+28//两字节DATA_FLAG 24字节数据
#define USER1_DOWN_DATA USER0_DOWN_DATA + USER_DATA_LEN
#define USER2_DOWN_DATA USER1_DOWN_DATA + USER_DATA_LEN
#define USER3_DOWN_DATA USER2_DOWN_DATA + USER_DATA_LEN
#define USER4_DOWN_DATA USER3_DOWN_DATA + USER_DATA_LEN
#define USER5_DOWN_DATA USER4_DOWN_DATA + USER_DATA_LEN
#define USER6_DOWN_DATA USER5_DOWN_DATA + USER_DATA_LEN
#define USER7_DOWN_DATA USER6_DOWN_DATA + USER_DATA_LEN
#define USER8_DOWN_DATA USER7_DOWN_DATA + USER_DATA_LEN
#define USER9_DOWN_DATA USER7_DOWN_DATA + USER_DATA_LEN
//电能暂存
#define ENERGY_TMP  USER9_DOWN_DATA
#define ENERGY_TMP_LEN 34
//升级日志
#define UPDATA_LOG ENERGY_TMP+ENERGY_TMP_LEN
#define UPDATA_LOG_START UPDATA_LOG+4
#define UPDATA_LOG_LEN 74  //94

//智能开关参数
#define DELAY_COUNT 200;
#define TOTAL_USER 4

//#define SWITCH_PARA UPDATA_LOG+UPDATA_LOG_LEN //8092
#define SWITCH_PARA 8192 //8K位置
#define SWITCH_PARA_STATR SWITCH_PARA+4   //智能开关参数起始位置
#define SWITCH_PARA_LEN 24*(TOTAL_USER+8)//数据总长度为1008


#define SYS_INFO_FLAG 63*1024   //监控序列号，系统序列号，MAC,
#define SYS_INFO_START SYS_INFO_FLAG+2

