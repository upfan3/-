	   OVER_LOAD,//RECOVER_SUPPLY, //恢复
	   LOW_VOLT,//低压
	   FLASH_BROKEN,
	   SHORT,    //短路
	   OVER_DHG, //过放
	   OVER_CHG, //过充
	   VOLT_DIFF_OVER,//电压差大
	   MAX_BEH
};

