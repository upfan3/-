	//u8 st_downModle; //下电模式
	u8  st_UserNb:4;//用户编号
	u8  st_downModle:4;//下电模式
	u16 st_RatedCurrent;      //低字节在前，高字节在后
	u16 st_OverCurrentLimit; //低字节在前，高字节在后
	u16 st_LDVoltage;         //低字节在前，高字节在后
}DCMParam0;//占8个字节空间

typedef struct
{
	u8 st_branchType;//支路类别
	DateTimeF34 st_stopDate;   //低字节在前，中字节在中间，高字节在后
	u16 st_LDDelay;      //低字节在前，高字节在后
	u16 st_LDEnergy;    //低字节在前，高字节在后
}DCMParam1;//占字节空间

typedef struct
{
  u8 st_branchType;//支路类别 0
	u8 st_TimingDownElecEnable; //定时下电使能      1
	u8 st_TimingDownElecStarMin;//定时下电开始分钟  2
	u8 st_TimingDownElecStarHour;//定时下电开始小时 3
	u8 st_TimingDownElecStopMin;//定时下电结束分钟  4
	u8 st_TimingDownElecStopHour;//定时下电结束小时 5

}DCMParam2;

typedef struct
{
	u8 st_branchType;//支路类别       0
	u8 st_OilMachineExemption; //油机免责 1
	u8 st_ExemptionStarMin;//免责开始分钟  2
	u8 st_ExemptionStarHour;//免责开始小时 3
	u8 st_ExemptionStopMin;//免责结束分钟  4
	u8 st_ExemptionStopHour;//免责结束小时 5

}DCMParam3;


typedef struct{
	u16  bit_online:1;
  u16  bit_CheckOut:1;
  u16  bit_setCmd:1;	
	u16  bit_setBreak:1;	
	u16  bit_ready:1;	
	u16  bit_time0flag:1;	
	u16  bit_time1flag:1;	
	u16  bit_stopTimeout:1;
	
	u16  bit_break:1; // 第8位：断开状态标志
	u16  bit_fuse:1;// 第9位：熔丝状态标志
	u16  setCmdAsk:1;	//设置命令请求后,屏闭该路下电操作，直到收到下一次数据查询响应为止
	u16  bit_setdown:1;	// 第11位：设置下电标志
	u16  NC13:1;	
	u16  bit_warn:1;	
	u16  overLoad:1;	
	u16  bit_broken:1;
	
	
}flagbit;



typedef struct{
	//u32 st_Energy;//电能  0.01KWH
	u32 st_BaseEnergy;//电能下电基本值
	
	//u16 st_V;//电压
	//s16 st_I;//电流
	
	
	u16 st_delayCheckCount;
	u16  st_stopSupplyCount;//超时计数
	
	u16  st_detectCount;//在线探查延时计数
	flagbit  st_statusflag;//开关状态位
	
	u8 rateI;
	u8 overLoadCount;
	
	u8 overLoadRecoveCount;
	u8 overLoadTimes;
	
	u16 stopTime0;
	u16 stopTime1;
	
	u16 CmdStatus;
	u8 authorizeflag;
	u8 setAuthorize;
	
	u16 alarmDelay;
	u8 reSetAlarmFlag;
	u8 readAuthorize;
	
	
}SwitchData;	



typedef struct{
	                                 //偏移量  //命令码
	Timer4 st_stopTime;//截止日期            0    2
	
  u16 st_downEnery;//下电电能   						4    3
	u16 st_downV;//下电电压       						6    4
	
	u16 st_downT;//下电时间      					  8    5
	u16 st_recoverV;//恢复电压              10    6
	
  u16 startTime0;//定时下电始             12    7
	u16 stopTime0;//定时下电终              14    8
	
  u16 startTime1;//免责下电始             16    9
	u16 stopTime1;//免责下电终              18    10
	
	u16 st_maxoverLoadI;//最大过载电流	     20    11
	u8 st_downMode;//下电模式               22    12
	u8 st_userGroud;//用户类型              23   1

}SwitchPara;

