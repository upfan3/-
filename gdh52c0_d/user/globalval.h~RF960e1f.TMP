typedef struct
{
	u16 Vbus;				//总线电压
	u16 Vbat;				//电池电压
	s16 Ibat;				//电池电流
	s16 Ibus;       //总线电流
	u16 B_SOC;
	u16 B_SOH;
	u16 B_capacity;		//电池额定容量
	u16 Cell_Num;			//电池芯数量
	u8 B_Status;			//电池充放电状态
//	u8 short_protect;	//短路保护告警
//	u8 over_Vprotect;	//过压保护告警
//	u8 over_Charge;		//过充告警
//	u8 over_shoot;		//过放告警
//	u8 over_Tcharge;	//电池充电过温告警
	u8 Nexttime;
	u8 WorkMode; //工作模式
	u16 Set_BattV;		//放电电池电压设定值
	u16 Set_BattA;		//放电电池电流百分比
	u16 MOS_Charg;						//充电回路控制
	u16 MOS_DisCharg;						//放电回路控制
	u16 Set_Batt_ChargA;	//充电电流设定值
	u16 Last_Time;	//剩余时间
	
	u16 CellV[16] ;//单体电压
	u16 CellVMax;   //单体电压最大值
	u16 CellVMin;   //单体电压最小值
	u16 CellTemp[16]; //单体温度
	u16 CellTempMax;  //单体温度最大值 
	u16 CellTempMin;  //单体温度最小值 
	u16 SW_version;
	u16 HW_version;
	u32 DisCap;
	u16 BattWarning;
	u16 prBattWarning;
}Battery;

typedef struct
{
