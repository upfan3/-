enum AlarmBehavior
{
	   NO=0,//正常
	   LOW_,//低
	   HIGH_,//高
	   UNNOMAL,//异常
	   BREAK,//断开
	   DOWNELE,//下电
	   BROKEN,//故障
	   COMM_BROKEN,//通信故障
	   STOP_SUPPLY,//到期
	   RECOVER_SUPPLY, //恢复
	   LOW_VOLT,//低压
	   MAX_BEH
};

typedef struct
{
	
  u16 wtype:5;
	u16 wstatus:1;
	u16 nb:6;
	u16 behavior:4; 
	
}WarnStruct;


typedef struct
{
	
  u16 st_AlarmType:8 ;
	u16 st_AlarmTrigger:1;
	u16 st_InputNb:3;
	u16 st_behavior:4;
}InputAlarm;


typedef struct
{
  
	u32 bit_OVER_V:1;       //过压0
	u32 bit_OWR_V: 1;       //电池欠压1
	u32 bit_OWR_V2:1;       //输出欠压
	u32 bit_BATTDOWN_ALARM:1; //电池下电告警18
	
	u32 bit_BATTSUPPLY_ALARM:1;//电池放电告警19
	u32 bit_IN_OVER_VA:1;  //A输入过压2
	u32 bit_IN_OVER_VB:1;  //B输入过压3
  u32 bit_IN_OVER_VC:1;  //B输入过压4
	
	u32 bit_IN_OWR_VA:1;   //输入欠压5
	u32 bit_IN_OWR_VB:1;   //输入欠压6
	u32 bit_IN_OWR_VC:1;   //输入欠压7	
	u32 bit_IN_OVER_IA:1;  //输入过流8
	
	u32 bit_IN_OVER_IB:1;  //输入过流9
	u32 bit_IN_OVER_IC:1;  //输入过流10
	u32 bit_OVER_FRQ:1;   //输入频率过高11	
	u32 bit_OWR_FRQ:1;    //输入频率过低12
	
	u32 bit_OWR_PHA:1;     //A缺相13
	u32 bit_OWR_PHB:1;     //B缺相14
	u32 bit_OWR_PHC:1;     //C缺相15
	u32 bit_SPDSW_DOWN:1;//防雷开关28
	
	u32 bit_spd:1;//防雷23
	u32 bit_ACINPUT:1;//交流输入26
	u32 bit_OILINPUT:1;	//油机输入27
	u32 bit_AC:1;//空调25	
	
	
	u32 bit_BATT_LTEMP:1;	  //电池温度低17
	u32 bit_BATT_HTEMP:1;   //电池温度高16
	u32 bit_WATERIN_DOWN:1;//水浸21
	u32 bit_SMOKE_BREAK:1;	//烟雾22
	
	u32 bit_DOOR_BREAK:1;//门禁20
	u32 bit_BATTFUSR_BREAK:1;//电池熔丝29
	u32 bit_USER1_BREAK:1;//用户熔丝1 30
	u32 bit_USER2_BREAK:1;//用户熔丝2 31
	

	
}Alarmbit;	


