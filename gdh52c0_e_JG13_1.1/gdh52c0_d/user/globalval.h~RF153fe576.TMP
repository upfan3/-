}DCdistribution;


enum AlarmType
{
   ON_ARARM=0, 
  
   OUT_V, //输出电压 1
	 BATT_I,//电池电流 2
	 IN_VA,  //A相电压 3
	 IN_VB,  //B相电压 4
	 IN_VC,  //C相电压 5
	

	 IN_IA,//A相电流   6
	 IN_IB,//B相电流   7
	 IN_IC,//C相电流   8
	
	 FRQ,//交流频率    9
	
	
	 OWR_PHA,//A相缺相 10
	 OWR_PHB,//B相缺相 11
	 OWR_PHC,//C相缺相 12
	 
	
	 USER_BREAK,//分路熔丝  13
	 USER_DOWN, //分路下电  14
	 MODULE,   //模块       15
	 

   BATT_TEMP,//电池温度   16
   MONITOR_BRANCH,//本地分路  17
	 
	 BATTDOWN_ALARM,//电池下电   18
	 BATTSUPPLY_ALARM,//电池供电 19
	 
	 
	 
	 DOOR_OPEN,//门禁           20  //28
	 WATER_INVASION,//水侵      21  //26
	 SMOKE,//烟雾               22  //27
	 SPD,//防雷                 23  //20
	 FAN,//风机                 24
	 AC,//空调                  25  //23
	 ACINPUT,//市电输入         26  //21
	 OILINPUT,//油机输入        27  //22
	 SPDSW,   //防雷开关        28  //19
	 BATTFUSR_BREAK,//电池熔丝  29  //29
	 LOAD_FUSE1,//负载熔丝1     30  //30
	 LOAD_FUSE2,//负载熔丝1     31  //31
	 
	 
	 MAX_TYPE

} ;	

