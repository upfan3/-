typedef enum
{
	 RUNNULL=0 ,     //未定义
	 SpikeMode,     //尖峰模式
	 PeakMode,        //高峰模式
	 NormalMode,      //正常模式  
   TroughMode      //低谷模式
	    
	        
}SpeakFlag;

typedef struct
{
	s16 st_yday;// 1~366 一年中的第几天,从1月1日开始，1月1日为第1日 
	s16 st_time[12];//0~1439 一天内的所有分钟数
}SPeakTimeInteval;	


typedef struct 
{
	u16 st_Ua;  //0
	u16 st_Ub;  //1
	u16 st_Uc;  //2
	u16 st_Frq; //3
	u32 st_energy1; //4,5
	u32 st_energy2; //6,7
	u32 st_energy3;  //8,9
	u16 st_Ia;//10//A电流
	u16 st_Ib;//11//B电流
	u16 st_Ic;//12//C电流
	u16 st_Pa;//13
	u16 st_Pb;//14
	u16 st_Pc;//15
	u32 st_totalenergy;//16,17
}ACdistribution;


typedef struct 
{
	u16 *pst_I;
