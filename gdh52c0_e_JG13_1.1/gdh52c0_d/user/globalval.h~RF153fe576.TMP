#define AD_PARA0 0x80 
#define AD_PARA  0x0100
#define SYS_PARA_FLAG  0x014A //参数已写入标志
#define SYS_PARA_LEN8  0x014C //单字节数据长
#define SYS_PARA_LEN16 0x014E //双字节数据长
#define SYS_PARA       0x0150 //参数首地址
#define USER_DOWN_PARA 0x0600
#define USER_DOWN_STAMP USER_DOWN_PARA+280  //单用户为 8+8+6+6=28 总共10个 280/512

#define ALARM_DATA_FlAG  0x0800//告警标志    单个告警 6字节时间+2字节信息 8字 
#define ALARM_DATA_LEN   ALARM_DATA_FlAG+2 //0x0802//告警长度
#define ALARM_DATA_STAR  ALARM_DATA_LEN+2  //0x0804//第一条告警
#define ALARM_DATA_HEAD   0x0804+12*2000        //各告警的实指针
#define ALARM_DATA_TAIL   ALARM_DATA_HEAD+12    //各告警的尾指针
#define ENERGY_DATA_FLAG  ALARM_DATA_TAIL+12    //电量存取标志
#define ENERGY_DATA_LEN   ENERGY_DATA_FLAG+2
#define ENERGY_DATA_STAR  ENERGY_DATA_LEN+2    //电量存放起始位置 //48条电量抄表记录
#define BATT_TEST_DATA_FLAG  ENERGY_DATA_STAR+50*48
#define BATT_TEST_DATA_LEN   BATT_TEST_DATA_FLAG+2
#define BATT_TEST_DATA_STAR  BATT_TEST_DATA_LEN+2

#define SYS_INFO_FLAG 63*1024   //监控序列号，系统序列号，MAC,
#define SYS_INFO_START SYS_INFO_FLAG+2

#define DCVOLTAGE 0    //系统电压
#define LOADCURR   2           //负载电流  
#define BATT_CURR1 4
#define USER_CURR1 6
#define USER_CURR2 8
#define USER_CURR 10
#define BATT_SOC   12     //电池容量
#define BATT_CURR2  14 //电池电流2
#define USER_VOLTAGE    16//用户电压
#define RECT_CURR 18       //整流模块总电流
#define SOLAR_CURR 20     //光伏模块总电流
#define INC_CURR 22      //A相电流
#define INA_CURR 24     //B相电流
#define INB_CURR 26      //C相电流
#define RECT_ENERGY 28     //整流发电量
#define PV_ENERGY 32     //光伏发电量
#define WIND_CURR 36  //风机电流
#define ENV_TEMP 38 //环境温度
#define HUMIDITY 40 //湿度
#define WORK_STATUS 42//工作状态
#define TOTAL_BATTI 43//总电池电流
#define BATT_FUSE 45//电池熔丝
#define LOAD_FUSE 46

#define LD_NONE 0
#define LD_VOL  1
#define LD_STOP_V_TIM  2
//#define LD_ENR  3
//#define LD_TIM  4
//#define LD_EXEMPTION 5
#define LD_STOP_POWER 3
#define ALARM_RECORD_LEN 2000
#define ENERGY_DATE_RECORD_LEN 48
#define DIS_BATT_RECORD_LEN 10
#define PARA_FLAG 0x6A6A

#define SOI        0x7E
#define EOI        0x0D 


#define cNew(p,t) p=(t *)pvPortMalloc(sizeof(t));\
                   p->Init();


